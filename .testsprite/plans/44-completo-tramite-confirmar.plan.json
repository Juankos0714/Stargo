    {"type": "action", "description": "Enter destination direction"},
    {"type": "action", "description": "Enter trámite: 'Radicar documento'"},
    {"type": "action", "description": "Enter instrucciones: 'Llevar cédula'"},
    {"type": "action", "description": "Enter peso: '1'"},
    {"type": "action", "description": "Click 'No hay transferencia'"},
    {"type": "action", "description": "Enter telefono: '3001234567'"},
    {"type": "action", "description": "Scroll down and click 'Confirmar pedido'"},
    {"type": "assertion", "description": "Either success confirmation or validation error should appear"}
  ]
