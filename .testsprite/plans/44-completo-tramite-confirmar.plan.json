  "name": "44 - Trámite completo confirmar",
  "planSteps": [
    {"type": "action", "description": "Navigate to https://stargo-zeta.vercel.app/nuevo-pedido"},
    {"type": "action", "description": "Look for a button that contains the word 'Trámite' or 'documento' and click it"},
