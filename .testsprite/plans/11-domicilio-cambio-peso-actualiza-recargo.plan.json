{
  "$schema": "https://raw.githubusercontent.com/TestSprite/testsprite-cli/v0.7.0/schemas/plan.schema.json",
  "projectId": "a99ea0ab-f34d-4275-b2a2-5d83404bf0ef",
  "type": "frontend",
  "name": "11 - Cambio de peso actualiza recargo",
  "planSteps": [
    {"type": "action", "description": "Navigate to https://stargo-zeta.vercel.app/nuevo-pedido"},
    {"type": "action", "description": "Click on 'Domicilio normal' button"},
    {"type": "action", "description": "Click on origin barrio search and type 'Centro'"},
    {"type": "action", "description": "Select the first 'Centro' option"},
    {"type": "action", "description": "Click on destination barrio search and type 'Norte'"},
    {"type": "action", "description": "Select the first option with 'Norte'"},
    {"type": "action", "description": "Enter directions for origin and destination"},
    {"type": "action", "description": "Enter '10' in the peso field"},
    {"type": "action", "description": "Click 'No hay transferencia'"},
    {"type": "action", "description": "Enter '3001234567' in telefono"},
    {"type": "assertion", "description": "The price summary should show the tarifa base without a peso surcharge"},
    {"type": "action", "description": "Change peso value to '25'"},
    {"type": "assertion", "description": "The price summary should now show a peso recargo line with a non-zero amount"}
  ]
}
