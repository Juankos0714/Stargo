  "type": "frontend",
  "name": "28 - Transferencia monto negativo muestra error",
  "planSteps": [
    {"type": "action", "description": "Navigate to https://stargo-zeta.vercel.app/nuevo-pedido"},
    {"type": "action", "description": "Click on 'Domicilio normal' button"},
    {"type": "action", "description": "Click on origin barrio search and type 'Centro'"},
    {"type": "action", "description": "Select the first 'Centro' option"},
    {"type": "action", "description": "Click on destination barrio search and type 'Centro'"},
    {"type": "action", "description": "Select the second option"},
    {"type": "action", "description": "Enter '10' in the peso field"},
    {"type": "action", "description": "Click 'Sí, hay transferencia'"},
    {"type": "action", "description": "Enter '-1000' in the transferencia monto field"},
    {"type": "action", "description": "Enter '3001234567' in telefono"},
    {"type": "action", "description": "Click 'Confirmar pedido' button"},
    {"type": "assertion", "description": "An error message about negative amount should appear"}
  ]
}
