# Credenciales para las suites contra Supabase de pruebas:
#   Parte 2 — RLS (tests/rls/*)                  → bun run test:rls
#   Parte 3 — Integración (tests/integration/*)  → bun run test:integration
#   Parte 5/6 — E2E (tests/e2e/*, Playwright)    → bun run test:e2e
#
# Copia este archivo a .env.test:
#   cp .env.test.example .env.test
#
# ⚠️ ADVERTENCIA: apunta SOLO a un proyecto Supabase de PRUEBAS (local o
# staging). Las suites crean usuarios y datos; jamás apuntes a producción.
#
# Estos son los keys por defecto de Supabase LOCAL (CLI + Docker): son
# públicos y fijos (solo válidos contra tu instancia local). Si usas un
# proyecto alojado de staging, reemplázalos con los del Dashboard.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJZDJvoHWSr5C4XDq9wRfKBdBrwD_0Q

# Password que se asigna a los usuarios de prueba creados por las suites.
TEST_USERS_PASSWORD=stargo-test-2026

# --- Opcionales (solo para la suite de integración, Parte 3) ----------------
# test:integration compila la app apuntando al Supabase de arriba y levanta
# `vite preview` automáticamente. Si ya tienes un servidor de la app
# corriendo (p. ej. `bun run preview`), apúntalo y la suite lo usará sin
# compilar ni levantar nada:
# TEST_BASE_URL=http://127.0.0.1:4175
# Reutiliza el último build sin recompilar (si no cambió el código):
# TEST_SKIP_BUILD=1
# Puerto del preview que levanta el runner (default 4175):
# TEST_PREVIEW_PORT=4175

# --- Opcionales (suite E2E, Partes 5 y 6) -----------------------------------
# test:e2e compila la app apuntando al Supabase de arriba y levanta `vite
# preview` en el puerto 4176. Un TEST_BASE_URL definido apunta a un servidor
# ya levantado (p. ej. un preview de Vercel) y desactiva el build/preview:
# TEST_BASE_URL=https://stargo-git-pr-42-tu-proyecto.vercel.app
# Subset de projects de Playwright (default: los 4 — chromium/webkit × desktop/móvil):
# E2E_PROJECTS=chromium-desktop,webkit-desktop
# Ventana visible para depurar localmente:
# E2E_HEADED=1
# Instala primero los navegadores (una sola vez):
#   bunx playwright install chromium webkit

# --- Opcionales (Parte 9 — cron de alertas) ---------------------------------
# El endpoint /api/cron/alertas exige este secreto (header x-cron-secret,
# Authorization: Bearer o ?secret=). Sin él el cron responde 503 y el test
# de integración del cron se omite:
# CRON_SECRET=test-cron-secret
