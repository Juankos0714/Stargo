# Dependencias
node_modules

# Output / build
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build
/dist

# Env (nunca commitear credenciales ni config local)
# .env.test puede contener la service_role key de un proyecto de staging;
# se ignora (solo se commitea la plantilla .env.test.example).
.env
.env.*
!.env.example
!.env.test.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tests / coverage
coverage/
test-results/
playwright-report/
# Estado temporal de la suite E2E (se siembra en cada corrida)
tests/e2e/.state.json
# Estado local del checklist go/no-go (Parte 10): fechas de verificaciones manuales
.go-no-go-estado.json

# TypeScript
*.tsbuildinfo

# OS / editores
.DS_Store
Thumbs.db
desktop.ini
.idea/

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
# Capacitor
android/
ios/

