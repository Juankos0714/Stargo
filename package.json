{
	"name": "stargo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest run --config vitest.ui.config.ts",
		"test:ui:coverage": "vitest run --config vitest.ui.config.ts --coverage",
		"test:rls": "bun --env-file=.env.test vitest run --config vitest.rls.config.ts",
		"test:integration": "bun --env-file=.env.test scripts/integration-run.mjs",
		"test:e2e": "bun --env-file=.env.test scripts/e2e-run.mjs",
		"test:e2e:headed": "bun --env-file=.env.test E2E_HEADED=1 scripts/e2e-run.mjs",
		"test:smoke": "bun scripts/smoke-test.mjs",
		"test:alertas": "bun scripts/probar-alertas.mjs",
		"test:push": "bun scripts/probar-push.mjs",
		"check:vapid": "bun scripts/verificar-vapid.mjs",
		"check:deploy": "bun scripts/check-despliegue-push.mjs",
		"bundle:budget": "bun scripts/bundle-budget.mjs",
		"perf:lighthouse": "bun scripts/lighthouse.mjs",
		"go-no-go": "bun scripts/go-no-go.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sentry/vite-plugin": "^5.4.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/bun": "^1.3.14",
		"@vitest/coverage-v8": "^4.1.10",
		"jsdom": "^30.0.1",
		"supabase": "^2.111.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "^6",
		"@fortawesome/free-solid-svg-icons": "^6",
		"@fortawesome/svelte-fontawesome": "^0.2.4",
		"@sentry/sveltekit": "10",
		"@supabase/supabase-js": "^2.112.2"
	}
}
