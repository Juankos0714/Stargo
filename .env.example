[TEMPLATE]
# Supabase (Dashboard → Project Settings → API)
# El anon key es público (se envía al navegador).
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Service role key — SOLO servidor ($env/dynamic/private), nunca pública.
# Permite al panel admin crear la cuenta de Supabase Auth de un domiciliario
# al registrarlo (si no está definida, el registro requiere cuenta existente).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# --- Parte 9 — Observabilidad y alertas -------------------------------------
# Sentry (error tracking). Dejar vacío desactiva Sentry sin romper nada.
PUBLIC_SENTRY_DSN=
# Credenciales del plugin de build de Sentry (subida de sourcemaps). Opcionales:
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cron de alertas (Parte 9). Vercel lo invoca con Authorization: Bearer <CRON_SECRET>.
# Dejar vacío desactiva el cron (responde 503).
CRON_SECRET=
# Webhook de notificaciones (Slack/Discord/Telegram, formato { text }). Vacío = sin webhook.
ALERTAS_WEBHOOK_URL=
# Umbrales de alerta (opcionales, con defaults):
ALERTAS_PENDIENTE_MINUTOS=30
ALERTAS_VENTANA_ERRORES_MIN=10
ALERTAS_UMBRAL_5XX=5
ALERTAS_UMBRAL_RATE_LIMIT=1
ALERTAS_COOLDOWN_MIN=60
ALERTAS_ENTORNO=local
